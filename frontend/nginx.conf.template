server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Look the backend up again every 10 s: its private IP changes on every redeploy, and a plain
    # proxy_pass would keep the address it resolved at start. NGINX_LOCAL_RESOLVERS comes from /etc/resolv.conf
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    # BACKEND_URL is the backend's address without a path, e.g. http://backend.railway.internal:8000
    set $backend_url ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_url;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 10m;
    }

    location /media/ {
        proxy_pass $backend_url;
        proxy_set_header Host $host;
    }

    # Hashed build assets can be cached for good
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # React Router: any other path serves the app
    location / {
        try_files $uri /index.html;
    }
}
