DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=splitit
POSTGRES_USER=splitit
POSTGRES_PASSWORD=splitit

# Gemini API key for embeddings and text generation (https://aistudio.google.com/apikey); leave empty to skip
GEMINI_API_KEY=

# Host ports (change if already in use on your machine)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=5173
